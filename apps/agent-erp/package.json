{
  "name": "agent-erp",
  "private": true,
  "version": "0.3.0",
  "description": "Reference app: sales order → shipment PoC built on X-Agent",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "tsx src/server/index.ts",
    "db:push": "prisma db push --skip-generate",
    "db:gen": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "eval": "tsx scripts/eval-interpret.ts",
    "eval:rules": "tsx scripts/eval-interpret.ts --engine=rules",
    "eval:lexicon": "tsx scripts/eval-lexicon.ts",
    "eval:enterprise": "tsx scripts/eval-enterprise-alias.ts",
    "eval:compare": "tsx scripts/eval-compare-models.ts",
    "eval:asr": "tsx scripts/eval-asr-utterances.ts",
    "trial:10": "tsx scripts/trial-10-utterances.ts",
    "trial:owner10": "tsx scripts/trial-owner-10.ts",
    "typecheck": "tsc --noEmit",
    "smoke:delivery": "tsx scripts/smoke-delivery-remaining.ts",
    "smoke:multiline": "tsx scripts/smoke-multiline-reserve.ts",
    "smoke:memory": "tsx scripts/smoke-memory.ts",
    "smoke:asr-normalize": "tsx scripts/smoke-asr-normalize.ts",
    "smoke:observation": "tsx scripts/smoke-observation.ts",
    "smoke:canvas": "playwright test e2e/canvas-smoke.spec.ts",
    "download:asr": "tsx scripts/download-asr-weights.ts",
    "sync:secrets": "tsx scripts/sync-cloud-secrets.ts",
    "say": "tsx scripts/speak.ts",
    "hotwords": "tsx scripts/export-hotwords.ts",
    "import:enterprise-aliases": "tsx scripts/import-enterprise-aliases.ts",
    "asr:cer": "tsx scripts/asr-cer.ts",
    "asr:wavs": "tsx scripts/asr-make-wavs.ts",
    "verify:asr": "tsx scripts/verify-asr-e2e.ts",
    "setup": "prisma generate && prisma db push --skip-generate && tsx prisma/seed.ts",
    "postinstall": "prisma generate --schema=prisma/schema.prisma || true"
  },
  "dependencies": {
    "@x-agent/core": "*",
    "@ant-design/icons": "^5.5.1",
    "@fastify/static": "^8.3.0",
    "@formily/antd-v5": "^1.1.2",
    "@formily/core": "^2.3.7",
    "@formily/react": "^2.3.7",
    "@prisma/client": "^5.22.0",
    "antd": "^5.22.0",
    "fastify": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sherpa-onnx-node": "^1.13.7"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "@playwright/test": "^1.49.1"
  }
}
