{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "客户查询",
  "x-verb": "customer.query",
  "x-description": "查询客户资料与信用额度。",
  "x-risk": "read",
  "x-requires-confirm": false,
  "properties": {
    "customerId": {
      "type": "string",
      "title": "客户",
      "x-component": "CustomerSelect",
      "x-decorator": "FormItem",
      "x-index": 10,
      "x-agent": {
        "extract": "customer",
        "resolution": "fuzzy_customer",
        "askIfMissing": false,
        "examples": ["查张三额度", "李四客户资料"]
      }
    },
    "keyword": {
      "type": "string",
      "title": "关键字",
      "x-component": "Input",
      "x-decorator": "FormItem",
      "x-index": 20,
      "x-agent": {
        "extract": "keyword",
        "resolution": "passthrough",
        "askIfMissing": false
      }
    }
  },
  "required": []
}
