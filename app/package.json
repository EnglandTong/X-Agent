{
  "name": "agt-erp",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "tsx src/server/index.ts",
    "db:push": "prisma db push --skip-generate",
    "db:gen": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "eval": "tsx scripts/eval-interpret.ts",
    "eval:rules": "tsx scripts/eval-interpret.ts --engine=rules",
    "setup": "prisma generate && prisma db push --skip-generate && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@fastify/static": "^8.3.0",
    "@formily/antd-v5": "^1.1.2",
    "@formily/core": "^2.3.7",
    "@formily/react": "^2.3.7",
    "@prisma/client": "^5.22.0",
    "antd": "^5.22.0",
    "fastify": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
