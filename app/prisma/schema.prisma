// AGT-ERP · 数据模型
// 阶段：验证用 SQLite（零安装）；切换 PostgreSQL 只需改 provider 与 url，模型无需改动
// 范围：仅覆盖「销售订单 → 出货」一条线，不在此线上的表一律不建

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Customer {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  level         String   @default("B") // A | B | C
  lastWarehouse String   @default("华东仓")
  creditLimit   Float    @default(100000)
  creditUsed    Float    @default(0)
  createdAt     DateTime @default(now())
  orders        Order[]
}

model Product {
  id     String      @id @default(cuid())
  model  String      @unique
  name   String
  price  Float
  unit   String      @default("个")
  items  OrderItem[]
  stocks Inventory[]
  deliveryItems DeliveryItem[]
}

model Inventory {
  id        String  @id @default(cuid())
  productId String
  warehouse String // 华东仓 / 华南仓 / 华北仓
  qty       Int     @default(0)
  /// 预留数量（PoC：直接挂在库存行上）
  reserved  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id])

  @@unique([productId, warehouse])
}

model Order {
  id             String      @id @default(cuid())
  no             String      @unique
  customerId     String
  warehouse      String?
  /// DRAFT | CONFIRMED | PARTIALLY_SHIPPED | SHIPPED | CANCELLED | SUPERSEDED
  status         String      @default("DRAFT")
  originNo       String?
  supersededByNo String?
  chainId        String?
  deliveryDate   DateTime?
  currency       String      @default("CNY")
  totalAmount    Float       @default(0)
  remark         String?
  cancelReason   String?
  createdBy      String      @default("owner")
  createdAt      DateTime    @default(now())
  customer       Customer    @relation(fields: [customerId], references: [id])
  items          OrderItem[]
  deliveries     Delivery[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  qty       Int
  unitPrice Float
  amount    Float
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Delivery {
  id        String         @id @default(cuid())
  no        String         @unique
  orderId   String
  warehouse String?
  /// DRAFT | CONFIRMED
  status    String         @default("DRAFT")
  remark    String?
  createdBy String         @default("owner")
  createdAt DateTime       @default(now())
  order     Order          @relation(fields: [orderId], references: [id])
  items     DeliveryItem[]
}

model DeliveryItem {
  id         String   @id @default(cuid())
  deliveryId String
  productId  String
  qty        Int
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])
}

/// 个人用语表 —— 习惯说法 → 动词或槽位目标（非向量库）
model PersonalLexeme {
  id          String    @id @default(cuid())
  userId      String    @default("owner")
  /// 归一化后用于匹配；写入时由代码生成
  phraseNorm  String
  /// 用户看见的原始说法
  phrase      String
  /// verb | slot
  kind        String
  /// kind=verb 时必填
  verb        String?
  /// kind=slot 时必填，如 customer / product；kind=verb 时为空串
  slot        String    @default("")
  /// 落库目标：客户/产品主键，或枚举值；动词映射可空
  targetId    String?
  targetLabel String?
  targetRaw   String?
  /// explicit | confirmed
  source      String
  /// active | rejected | retired
  status      String    @default("active")
  hits        Int       @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, phraseNorm, kind, slot])
  @@index([userId, status])
  @@index([userId, kind, verb])
}

/// 个人用语的「证据」—— 每观察到一次「说法 → 目标」记一行
///
/// 为什么单独一张表：决策 #28 要求说法先进**候选区**，稳定复现才升格成记忆卡。
/// 「稳定」的判据是**跨天**（≥2 次且跨 ≥2 天），所以必须按天记账，不能只存一个计数。
/// 单行语义 = 某用户某个说法在某个**自然日**指向了某个目标（同一天重复只算一次）。
model LexemeEvidence {
  id          String   @id @default(cuid())
  userId      String   @default("owner")
  /// 归一化说法（与 PersonalLexeme.phraseNorm 同规则）
  phraseNorm  String
  /// 人看见的原始说法（审计用）
  phrase      String
  /// customer | product（一代只观察这两个槽）
  slot        String
  /// 落库目标（客户/产品主键）
  targetId    String
  targetLabel String?
  /// 出现的自然日 YYYY-MM-DD —— 跨天判定只看这一列
  day         String
  /// observed（自动观察）| explicit（点了「记住」）
  source      String
  createdAt   DateTime @default(now())

  @@unique([userId, phraseNorm, slot, targetId, day])
  @@index([userId, phraseNorm, slot])
}

/// 画布格子 —— 既是界面上的一格，也是一条不可变审计记录
model Panel {
  id            String   @id @default(cuid())
  seq           Int
  sessionId     String   @default("default")
  verb          String
  title         String   @default("")
  status        String   @default("SUBMITTED")
  utterance     String?
  slots         String?
  args          String?
  result        String?
  ok            Boolean  @default(true)
  correlationId String?
  entities      String?
  supersedesId  String?
  actor         String   @default("owner")
  createdAt     DateTime @default(now())

  @@index([sessionId, seq])
  @@index([correlationId])
  @@index([supersedesId])
}
