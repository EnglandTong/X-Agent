{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "释放预留",
  "x-verb": "inventory.release",
  "x-description": "释放产品在指定仓库的预留数量。",
  "x-risk": "write",
  "x-requires-confirm": true,
  "properties": {
    "productId": {
      "type": "string",
      "title": "产品",
      "x-component": "ProductSelect",
      "x-decorator": "FormItem",
      "x-validator": [{ "required": true }],
      "x-index": 10,
      "x-agent": {
        "extract": "product",
        "resolution": "fuzzy_product",
        "askIfMissing": true
      }
    },
    "warehouseId": {
      "type": "string",
      "title": "仓库",
      "enum": ["华东仓", "华南仓", "华北仓"],
      "x-component": "Select",
      "x-decorator": "FormItem",
      "x-validator": [{ "required": true }],
      "x-index": 20,
      "x-agent": {
        "extract": "warehouse",
        "resolution": "enum",
        "askIfMissing": true
      }
    },
    "qty": {
      "type": "number",
      "title": "释放数量",
      "minimum": 1,
      "x-component": "NumberPicker",
      "x-decorator": "FormItem",
      "x-validator": [{ "required": true }],
      "x-index": 30,
      "x-agent": {
        "extract": "quantity",
        "resolution": "number_normalize",
        "askIfMissing": true
      }
    }
  },
  "required": ["productId", "warehouseId", "qty"]
}
