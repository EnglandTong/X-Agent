node_modules/
dist/
test-results/
playwright-report/

# IDE / agent 本地目录（不入库）
.codebuddy/
.workbuddy/
*.db
*.db-journal
.DS_Store

# secrets / local config — never commit
.env
.env.local

# delivery snapshots — regenerate after milestones; not source of truth
Agent_ERP.bundle
agt-erp-src.zip
*.bundle

# local run logs (npm run serve / build 的重定向输出)
*.log

# eval run artifacts (keep utterances + failures.jsonl committed)
apps/agent-erp/eval/results/
# ASR 评测音频（由 npm run asr:wavs 生成，不入库）
apps/agent-erp/eval/asr-wavs/
# 真人录音语料（画布「存为语料」生成，含人声，绝不入库）
apps/agent-erp/eval/asr-wavs-real/*
!apps/agent-erp/eval/asr-wavs-real/README.md
*.wav

# large model weights (see app/models/OFFLINE_BUNDLE.md)
*.onnx
*.gguf
*.bin
*.pt
*.safetensors
apps/agent-erp/models/asr/sensevoice/**
!apps/agent-erp/models/asr/sensevoice/.gitkeep
!apps/agent-erp/models/asr/sensevoice/README*
# tokens.txt 是文本且运行必需（308KB），权重是二进制不入库，但词表必须跟着走
!apps/agent-erp/models/asr/sensevoice/tokens.txt
apps/agent-erp/models/llm/**/*.gguf
apps/agent-erp/models/llm/**/*.bin
